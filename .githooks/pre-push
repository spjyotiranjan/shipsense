#!/bin/sh
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*)
      case "$local_sha" in
        0000000000000000000000000000000000000000) ;;
        *) node scripts/check-branch-name.mjs "${remote_ref#refs/heads/}" ;;
      esac
      ;;
  esac
done
