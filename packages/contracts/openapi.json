{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "DEPENDENCY_UNAVAILABLE",
              "INVALID_REQUEST",
              "INTERNAL_ERROR"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Requestid",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "requestId",
          "retryable"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "FoundationResponse": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "const": "local-foundation",
            "default": "local-foundation",
            "title": "Mode",
            "type": "string"
          },
          "service": {
            "const": "shipsense-api",
            "default": "shipsense-api",
            "title": "Service",
            "type": "string"
          }
        },
        "title": "FoundationResponse",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ReadinessResponse",
        "type": "object"
      },
      "VersionResponse": {
        "additionalProperties": false,
        "properties": {
          "apiVersion": {
            "const": "v1",
            "default": "v1",
            "title": "Apiversion",
            "type": "string"
          },
          "observedAt": {
            "format": "date-time",
            "title": "Observedat",
            "type": "string"
          },
          "service": {
            "const": "shipsense-api",
            "default": "shipsense-api",
            "title": "Service",
            "type": "string"
          },
          "version": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "observedAt"
        ],
        "title": "VersionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ShipSense local diagnostics",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/version": {
      "get": {
        "operationId": "version_api_v1_version_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-request-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9_-]{1,64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "apiVersion": "v1",
                  "observedAt": "2026-11-08T00:00:00Z",
                  "service": "shipsense-api",
                  "version": "0.1.0-dev"
                },
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "The request is invalid.",
                    "requestId": "req-local-001",
                    "retryable": false
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "The request could not be completed.",
                    "requestId": "req-local-001",
                    "retryable": true
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Version"
      }
    },
    "/foundation": {
      "get": {
        "operationId": "foundation_foundation_get",
        "responses": {
          "200": {
