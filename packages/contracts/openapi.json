                  "$ref": "#/components/schemas/FoundationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "The request is invalid.",
                    "requestId": "req-local-001",
                    "retryable": false
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
