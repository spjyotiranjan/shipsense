# Server-only development configuration. Copy to .env and fill privately.
# Load explicitly for the API: uv run --env-file .env --frozen --package shipsense-api uvicorn shipsense_api.main:create_app --factory --host 127.0.0.1 --port 8000 --no-access-log
# Empty placeholders keep readiness 503. Never use NEXT_PUBLIC_ for these values.
SHIPSENSE_PROFILE=local
SHIPSENSE_DEPENDENCIES=hosted
# Hosted mongodb+srv:// or mongodb:// URI, including URL-encoded user/password.
# TLS verification is mandatory. No local database is started.
SHIPSENSE_MONGODB_URI=
SHIPSENSE_MONGODB_DATABASE=
# Private Cloudflare R2 S3 API endpoint, bucket and bucket-scoped credentials.
SHIPSENSE_R2_ENDPOINT=
SHIPSENSE_R2_BUCKET=
SHIPSENSE_R2_ACCESS_KEY_ID=
SHIPSENSE_R2_SECRET_ACCESS_KEY=
# Next.js server-only upstream; the web process receives only this setting.
SHIPSENSE_API_ORIGIN=http://127.0.0.1:8000
