# Server-only existing hosted dependencies. Copy to ignored .env.local.
# Keep credentials out of Next.js/browser environments.
SHIPSENSE_PROFILE=local
# Base name only; effective database is <base>-local (maximum 63 bytes total).
SHIPSENSE_MONGODB_URI=
SHIPSENSE_MONGODB_DATABASE=
SHIPSENSE_R2_ENDPOINT=
SHIPSENSE_R2_BUCKET=
SHIPSENSE_R2_ACCESS_KEY_ID=
SHIPSENSE_R2_SECRET_ACCESS_KEY=
