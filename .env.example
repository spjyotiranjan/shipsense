# Server-only existing hosted dependencies. Copy to ignored .env.local.
# Keep the MongoDB and R2 credentials out of the Next.js process.
SHIPSENSE_PROFILE=local
# Base name only; effective database is <base>-local (maximum 63 bytes total).
SHIPSENSE_MONGODB_URI=
SHIPSENSE_MONGODB_DATABASE=
SHIPSENSE_R2_ENDPOINT=
SHIPSENSE_R2_BUCKET=
SHIPSENSE_R2_ACCESS_KEY_ID=
SHIPSENSE_R2_SECRET_ACCESS_KEY=

# Phase 2 Google and GitHub OAuth. Server-only non-production app credentials.
# NEXTAUTH_URL is the HTTPS browser origin when testing secure session cookies.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Azure Communication Services Email. Server-only connection string and linked MailFrom address.
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_EMAIL_SENDER=
